---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  const byTag = new Map<string, CollectionEntry<'writing'>[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'writing'>[];
}

const { tag, posts } = Astro.props;
const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout title={`#${tag}`} description={`Writing tagged ${tag}.`}>
  <p class="post-meta"><a href="/writing/tags/">← all tags</a></p>
  <h1>#{tag}</h1>
  <ul class="archive-list">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}/`}>{post.data.title}</a>
        <span class="archive-date">{shortDate(post.data.pubDate)}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
