---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_AUTHOR } from '../../consts';
import { getPublishedWriting, getRelatedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedWriting();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: getRelatedPosts(post, posts) },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
  related: CollectionEntry<'writing'>[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  image={post.data.image}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Writing', url: '/writing/' },
    { name: post.data.title },
  ]}
>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      {post.data.draft && (
        <p class="draft-badge">DRAFT — not visible in production</p>
      )}
      <p class="post-meta">
        by <a class="post-author" rel="author" href="/about">{SITE_AUTHOR}</a>
        {' · '}
        <FormattedDate date={post.data.pubDate} />
        {post.data.updatedDate && (
          <> · updated <FormattedDate date={post.data.updatedDate} /></>
        )}
        {post.data.tags.length > 0 && (
          <>
            {' · '}
            {post.data.tags.map((tag, i) => (
              <>
                {i > 0 && ', '}
                <a class="post-tag" href={`/writing/tags/${tag}/`}>{tag}</a>
              </>
            ))}
          </>
        )}
      </p>
    </header>
    <Content />
  </article>
  {related.length > 0 && (
    <nav class="related" aria-label="Related posts">
      <h2>related</h2>
      <ul>
        {related.map((p) => (
          <li><a href={`/writing/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    </nav>
  )}
</BaseLayout>

<style>
  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .related h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin: 0 0 0.6rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>
