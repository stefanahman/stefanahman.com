---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<BaseLayout>
  <section>
    <h1>Stefan Åhman</h1>
    <p>
      Software engineer in Stockholm. I write about things I'm building, things I'm learning, and the occasional detour.
    </p>
  </section>

  <section>
    <h2>Recent writing</h2>
    <ul class="archive-list">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          <span class="archive-date">{shortDate(post.data.pubDate)}</span>
        </li>
      ))}
    </ul>
    <p style="margin-top: 1.5rem;"><a href="/writing">All writing →</a></p>
  </section>
</BaseLayout>
