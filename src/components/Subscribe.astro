---
// Email capture via Buttondown. Buttondown sends from the newsletter@ domain;
// this site stays the canonical home for the writing itself.
// See docs/promotion-playbook-2026.md (Priority 2).
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <h2 id="subscribe-heading">New writing by email</h2>
  <p>One email when something new goes up.</p>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/stefanahman"
    method="post"
    target="_blank"
    class="subscribe-form embeddable-buttondown-form"
  >
    <label class="visually-hidden" for="bd-email">Email address</label>
    <input
      type="email"
      name="email"
      id="bd-email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Subscribe</button>
  </form>
</section>

<style>
  .subscribe {
    margin-top: var(--space-5);
    padding: var(--space-3);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-sans);
  }

  .subscribe h2 {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin: 0 0 var(--space-1);
  }

  .subscribe p {
    font-size: 0.9rem;
    color: var(--fg-muted);
    margin: 0 0 var(--space-2);
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .subscribe-form input[type='email'] {
    flex: 1;
    min-width: 12rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem 0.7rem;
    color: var(--fg);
    font: inherit;
    font-size: 0.9rem;
  }

  .subscribe-form input[type='email']:focus {
    outline: none;
    border-color: var(--accent);
  }

  .subscribe-form button {
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .subscribe-form button:hover {
    background: var(--fg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
